DISCORD_TOKEN=your_discord_bot_token_here
MONGODB_URI=your_mongodb_atlas_connection_string_here
PORT=3000

# Web CAD
# Nothing is required. The CAD signs in through /auth/site/callback, the same
# callback the dashboard uses, so no extra Discord redirect URI is needed.
#
# Optional: only set this if the CAD is given its own subdomain, in which case it
# is served at that host's root path instead of /cad.
# CAD_DOMAIN=cad.roleplaymanager.xyz
