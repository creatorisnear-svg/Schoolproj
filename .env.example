DISCORD_TOKEN=your_discord_bot_token_here
MONGODB_URI=your_mongodb_atlas_connection_string_here
PORT=3000

# Web CAD
# The subdomain the CAD is served from. When set, the CAD is served at the root
# path on that host, and the OAuth redirect_uri is built from it. Leave unset to
# serve the CAD at /cad on whatever host the request arrived on.
CAD_DOMAIN=cad.roleplaymanager.xyz
# Signs CAD session cookies. Falls back to PORTAL_SECRET, then
# DISCORD_CLIENT_SECRET. If none is set the CAD refuses to sign sessions at all
# rather than using a predictable value.
CAD_SECRET=a_long_random_string
